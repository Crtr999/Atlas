# Slack Bot Configuration
# Create a Slack App at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Anthropic API Key
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Path to Excel data file (defaults to ./CBC_Settlement_Funding_Master_v4.xlsx)
EXCEL_PATH=./CBC_Settlement_Funding_Master_v4.xlsx

# Path to the generated HTML output (defaults to ./CBCAssistant_Complete.html)
HTML_OUTPUT_PATH=./CBCAssistant_Complete.html

# ─────────────────────────────────────────────────────────────────
# Outbound Email System Configuration
# ─────────────────────────────────────────────────────────────────

# Email Provider: "smtp" or "sendgrid"
EMAIL_PROVIDER=smtp

# SMTP Configuration (for sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# SendGrid (alternative to SMTP)
# SENDGRID_API_KEY=SG.your-key-here

# IMAP Configuration (for receiving replies)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your-email@gmail.com
IMAP_PASSWORD=your-app-password
IMAP_USE_SSL=true
IMAP_FOLDER=INBOX

# Sender Identity
SENDER_EMAIL=your-email@deedstreetcapital.com
SENDER_NAME=Deed Street Capital

# Rate Limiting
DAILY_SEND_LIMIT=500
SEND_DELAY_SECONDS=5

# Email Warmup (recommended for new email accounts)
WARMUP_ENABLED=true
WARMUP_START_COUNT=25
WARMUP_DAILY_INCREMENT=25

# Calendly link for scheduling calls
CALENDLY_LINK=https://calendly.com/your-link

# Reply checking interval (seconds)
IMAP_POLL_INTERVAL=120

# Claude model for AI responses
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Database path (defaults to ./outbound_email.db)
# EMAIL_DB_PATH=./outbound_email.db
