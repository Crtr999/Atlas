# Slack Bot Configuration
# Create a Slack App at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Anthropic API Key
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Path to Excel data file (defaults to ./CBC_Settlement_Funding_Master_v4.xlsx)
EXCEL_PATH=./CBC_Settlement_Funding_Master_v4.xlsx

# Path to the generated HTML output (defaults to ./CBCAssistant_Complete.html)
HTML_OUTPUT_PATH=./CBCAssistant_Complete.html
